@model Comp2139_Assignment1.Areas.InventoryManagement.Models.Orders

@{
    ViewData["Title"] = "Order Confirmation";
}

<h1>@ViewData["Title"]</h1>

<h3>Order Details</h3>
<p><strong>Order ID:</strong> @Model.Id</p>
<p><strong>Customer Name:</strong> @Model.CustomerName</p>
<p><strong>Shipping Address:</strong> @Model.ShippingAddress</p>
<p><strong>Order Date:</strong> @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</p>

<h3>Order Items</h3>
<table class="table">
    <thead>
    <tr>
        <th>Product Name</th>
        <th>Quantity</th>
        <th>Price</th>
        <th>Total</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.OrderItems)
    {
        <tr>
            <td>@item.Product.Name</td>
            <td>@item.Quantity</td>
            <td>@item.Product.Price.ToString("C")</td>
            <td>@((item.Quantity * item.Product.Price).ToString("C"))</td>
        </tr>
    }
    </tbody>
</table>

<h3>Total Price: @(((decimal)ViewData["TotalPrice"]).ToString("C"))</h3>

<a href="@Url.Action("Index", "Orders")" class="btn btn-primary">Back to Orders</a>