@{
    ViewData["Title"] = "Server Error";
}

<div class="container text-center py-5">
    <h1 class="display-3 text-danger">500</h1>
    <h2 class="mb-4">Internal Server Error</h2>
    <p class="text-muted mb-4">
        Something went wrong on our end. We’re working to resolve the issue.
    </p>
    <a href="/" class="btn btn-outline-danger">
        <i class="bi bi-arrow-left-circle"></i> Back to Safety
    </a>

    @if (Model?.RequestId != null)
    {
        <p class="text-muted mt-4">
            <small>Request ID: <code>@Model.RequestId</code></small>
        </p>
    }
</div>